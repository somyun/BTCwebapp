rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /publicCache/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /publicForms/{formKey} {
      allow read: if true;
      allow write: if false;

      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // T5 submissions are accepted and queried only through validated HTTPS Functions.
    match /measurementSubmissions/{submissionId} {
      allow read, write: if false;
    }

    match /systemConfig/{documentId} {
      allow read, write: if false;
    }

    match /submissionRateLimits/{documentId} {
      allow read, write: if false;
    }

    // T7 device credentials, full FCM tokens, and delivery receipts are server-only.
    match /notificationDevices/{deviceId} {
      allow read, write: if false;

      match /receipts/{eventId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
